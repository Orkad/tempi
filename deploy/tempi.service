[Unit]
Description=tempi — enregistrement de la température DS18B20
Documentation=https://github.com/Orkad/tempi
After=network-online.target
Wants=network-online.target

[Service]
# notify : le service n'est annoncé actif qu'une fois Kestrel à l'écoute et la
# collecte démarrée. L'annonce est faite par AddSystemd() côté application.
Type=notify
User=tempi
Group=tempi

# systemd crée /var/lib/tempi et l'attribue au service.
StateDirectory=tempi
Environment=TEMPI_DB=/var/lib/tempi/tempi.db

# Le tiret initial rend le fichier facultatif : le service démarre même sans lui.
EnvironmentFile=-/etc/tempi/tempi.env

ExecStart=/opt/tempi/bin/tempi run
Restart=on-failure
RestartSec=5s

# Durcissement. Le bus 1-Wire est lu dans /sys, accessible en lecture seule :
# aucune de ces restrictions ne gêne la collecte.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# AF_NETLINK est nécessaire à getaddrinfo de la glibc, donc à la résolution de
# noms — et donc à la source de température extérieure. L'ancienne unité ne
# l'autorisait pas : le service tournait tant que TEMPI_OUTDOOR_PROVIDER restait
# vide, ce qui était le cas par défaut.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Le compilateur à la volée de .NET a besoin de pages mémoire à la fois
# inscriptibles et exécutables : avec MemoryDenyWriteExecute=yes, le service ne
# démarre pas. La directive redeviendrait possible en compilation native
# anticipée, où plus aucun code n'est généré à l'exécution.
MemoryDenyWriteExecute=no

SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
