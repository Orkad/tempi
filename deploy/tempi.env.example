# Configuration de tempi — à copier vers /etc/tempi/tempi.env
#
# Ce fichier est lu par systemd (EnvironmentFile) : une variable par ligne,
# sans « export », sans guillemets superflus.

# --- Stockage ---------------------------------------------------------------

# Emplacement de la base SQLite. Laissé tel quel par le service systemd.
#TEMPI_DB=/var/lib/tempi/tempi.db

# Nombre de jours de mesures conservés. 0 (défaut) = conservation illimitée.
# Ordre de grandeur : une mesure occupe environ 20 octets, soit ~10 Mio par an
# et par capteur avec un relevé chaque minute.
#TEMPI_RETENTION_DAYS=0

# --- Collecte ---------------------------------------------------------------

# Intervalle entre deux relevés, en secondes (minimum 1, défaut 60).
#TEMPI_INTERVAL=60

# Bande morte : n'enregistre que si l'écart avec la dernière valeur retenue
# atteint ce seuil, en °C. Réduit fortement les écritures sur la carte SD.
# 0 (défaut) = tout enregistrer. 0.1 correspond à la résolution du DS18B20
# en 12 bits (0,0625 °C).
#TEMPI_MIN_DELTA=0

# Durée maximale sans enregistrement malgré la bande morte, en secondes.
# Garantit un point régulier et prouve que le capteur répond toujours.
#TEMPI_MAX_INTERVAL=900

# --- Capteur ----------------------------------------------------------------

# Répertoire des périphériques 1-Wire exposé par le noyau.
#TEMPI_W1_DIR=/sys/bus/w1/devices

# Nombre de tentatives par relevé avant d'abandonner (erreurs de CRC).
#TEMPI_READ_RETRIES=3

# Accepter la valeur 85 °C, qui traduit normalement une conversion ratée.
# À n'activer que si vous mesurez réellement des températures proches de 85 °C.
#TEMPI_ALLOW_RESET_VALUE=0

# Capteur simulé, pour tester sans matériel.
#TEMPI_SIMULATE=0

# --- Interface web ----------------------------------------------------------

# Adresse d'écoute. 127.0.0.1 (défaut) n'est joignable que depuis le Raspberry
# Pi lui-même. Mettre 0.0.0.0 pour ouvrir au réseau local — l'interface n'ayant
# aucune authentification, ne le faites que sur un réseau de confiance.
TEMPI_HOST=127.0.0.1
TEMPI_PORT=8080

# --- HTTPS ------------------------------------------------------------------

# Certificat et clé privée, au format PEM. Renseigner les deux fait basculer
# l'interface en https:// sur le même port ; les laisser vides la laisse en
# clair. « sudo tempi cert » fabrique un certificat pour le réseau local, et la
# section « Accès réseau » du README décrit aussi la voie Let's Encrypt.
#
# La clé doit être lisible par l'utilisateur « tempi » :
#   sudo chgrp tempi /etc/tempi/tls/tempi-key.pem
#   sudo chmod 640   /etc/tempi/tls/tempi-key.pem
#TEMPI_TLS_CERT=/etc/tempi/tls/tempi-cert.pem
#TEMPI_TLS_KEY=/etc/tempi/tls/tempi-key.pem
