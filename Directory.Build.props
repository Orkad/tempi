<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NeutralLanguage>fr</NeutralLanguage>

    <!-- Version SemVer (https://semver.org) du produit .NET, distincte de la 1.0.0
         qu'a portée l'implémentation Python d'origine. Doit toujours valoir la même
         chose que la constante `TempiVersion.Value` — VersionTests.cs le vérifie à
         chaque build — et c'est cette dernière, pas cette propriété, que l'on
         modifie pour préparer une release : voir sa remarque XML doc. Une release
         (tag `vX.Y.Z`) republie cette valeur via `-p:Version` dans release.yml, qui
         vérifie aussi qu'elle correspond au tag avant de publier. -->
    <Version>2.1.3</Version>

    <!-- Économise l'embarquement d'ICU (~28 Mo) sur une carte SD. Les fuseaux
         horaires continuent de fonctionner : sous Linux ils viennent de
         /usr/share/zoneinfo, pas d'ICU. Appliqué aussi aux tests, pour qu'ils
         exercent le même comportement de formatage que le binaire livré. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
