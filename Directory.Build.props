<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NeutralLanguage>fr</NeutralLanguage>
    <Version>1.0.0</Version>

    <!-- Économise l'embarquement d'ICU (~28 Mo) sur une carte SD. Les fuseaux
         horaires continuent de fonctionner : sous Linux ils viennent de
         /usr/share/zoneinfo, pas d'ICU. Appliqué aussi aux tests, pour qu'ils
         exercent le même comportement de formatage que le binaire livré. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
